# ==============================================================================
# AI ISP Chatbot & Dashboard — Environment Configuration Template
# Copy this file to `.env` and fill in your actual values.
# Never commit the actual `.env` file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Monitoring
# ------------------------------------------------------------------------------
CHATBOT_DEBUG=false
LOG_LEVEL=INFO
ENABLE_TRACING=true
ENABLE_CRM_LOGS=true
SESSION_TTL_MINUTES=60

# ------------------------------------------------------------------------------
# 2. Telegram Bot Configuration
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ------------------------------------------------------------------------------
# 3. Database Configuration (MySQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=isp_chatbot

# ------------------------------------------------------------------------------
# 4. Dashboard Authentication & Security (JWT)
# ------------------------------------------------------------------------------
DASHBOARD_JWT_SECRET=replace_with_a_strong_random_jwt_secret_key

# ------------------------------------------------------------------------------
# 5. LLM Provider Configuration
# Supported providers: gemini | ollama | lmstudio
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_USE_FOR_INTENT=true
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=500

# Google Gemini (Required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Ollama (Used when LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=dagbs/qwen2.5-coder-7b-instruct-abliterated:latest

# LM Studio (Used when LLM_PROVIDER=lmstudio)
LMSTUDIO_URL=http://127.0.0.1:1234/v1/chat/completions
LMSTUDIO_MODEL=local-model

# OpenAI API Key (Optional — only if using remote OpenAI Whisper API in voice_service.py)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 6. CRM Integration (HyperCRM)
# ------------------------------------------------------------------------------
CRM_BASE_URL=http://localhost:8090/api/crm
CRM_USERNAME=your_crm_manager_username
CRM_PASSWORD=your_crm_manager_password
CRM_API_KEY=your_crm_api_key_if_applicable
CRM_USER_LOGIN_ENDPOINT=http://localhost:8090/api/crm/login-user
CRM_TIMEOUT=30
ISP_RENEWAL_DAY=3

# ------------------------------------------------------------------------------
# 7. RAG & Knowledge Base Configuration
# ------------------------------------------------------------------------------
RAG_KNOWLEDGE_FILE=chatbot.xls
RAG_CHUNK_SIZE=350
RAG_OVERLAP=50
RAG_N_RESULTS=10

# ------------------------------------------------------------------------------
# 8. Rate Limiting & Monthly Quotas
# ------------------------------------------------------------------------------
SPAM_MAX_CALLS=10
SPAM_WINDOW_SECONDS=20
SPAM_BLOCK_MINUTES=5
PRES_MAX_CALLS=10
PRES_WINDOW_SECONDS=60
MAX_IMAGES_PER_MONTH=15
MAX_VOICES_PER_MONTH=50
MAX_MESSAGES_PER_MONTH=200
